scp ... root@47.98.102.197:/tmp/
ssh root@47.98.102.197 "docker cp ... zhidang-backend-1:... && docker compose -f /opt/zhidang/docker-compose.yml restart backend"
# 验证：ssh root@47.98.102.197 'docker exec -e PYTHONPATH=/app/backend zhidang-backend-1 python3 -c "..."'
